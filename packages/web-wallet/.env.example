# Snap origin - defaults to local dev snap server
# For production builds, set to: npm:@zcashcommunitygrants/webzjs-zcash-snap
SNAP_ORIGIN="local:http://localhost:8080"

# Lightwalletd gRPC-web proxy - defaults to https://zjs.zec.rocks/mainnet
# (the proxy routes PathPrefix /mainnet + /testnet; the prefix is required)
# Only override if running a local lightwalletd proxy
# LIGHTWALLETD_PROXY=http://localhost:1234/mainnet

# Dev server port - defaults to 3000
# PORT=3000
